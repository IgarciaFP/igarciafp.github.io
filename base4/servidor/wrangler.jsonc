{
  // Configuración de despliegue del servidor de control (Cloudflare Workers Builds).
  // En Cloudflare, el «Directorio raíz» de la compilación debe ser: base4/servidor
  // "name" tiene que coincidir con el nombre del Worker en el panel de Cloudflare.
  "name": "igarciafp-github-io",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Conserva las variables definidas en el panel al desplegar desde el repositorio.
  "keep_vars": true,
  "observability": { "enabled": true }
}
